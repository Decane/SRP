[logic]
active = sr_idle@3

[sr_idle@common]
on_info = {=level_changing} sr_idle@7 %=stop_sound%

[sr_idle@3]
on_info = {=actor_in_zone(esc_stalkers_dialog_zone_2)} %=play_sound(esc_stalker_assemble_2_1:stalker:esc_leader_stalkerbase_name)% sr_idle@4s

[sr_idle@4s]: sr_idle@common
on_signal = sound_end | sr_idle@4

[sr_idle@4]: sr_idle@common
on_game_timer = 10 | %=play_sound(esc_stalker_assemble_2_2:stalker)% sr_idle@5s

[sr_idle@5s]: sr_idle@common
on_signal = sound_end | sr_idle@5

[sr_idle@5]: sr_idle@common
on_game_timer = 10 | %=play_sound(esc_stalker_assemble_2_3:stalker:esc_leader_stalkerbase_name)% sr_idle@6s

[sr_idle@6s]: sr_idle@common
on_signal = sound_end | sr_idle@6

[sr_idle@6]: sr_idle@common
on_game_timer = 10 | %=play_sound(esc_stalker_assemble_2_4:stalker)% sr_idle@7

[sr_idle@7]
